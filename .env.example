# Copiez ce fichier en .env (gitignoré) et renseignez les valeurs.
# En production, préférez de vraies variables d'environnement / un gestionnaire de secrets.

# --- Base de données (profil prod) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/olympics
SPRING_DATASOURCE_USERNAME=olympics
SPRING_DATASOURCE_PASSWORD=

# --- JWT (secret fort, >= 64 caractères pour HS512) ---
JWT_SECRET=
JWT_ISSUER=jodak
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# --- Bootstrap du premier administrateur (premier démarrage uniquement) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Sauvegarde / Réinitialisation ---
BACKUP_STORAGE_DIR=
ADMIN_RESET_ENABLED=false
ADMIN_RESET_CONFIRMATION_PHRASE=REINITIALISER-DAKAR-2026
