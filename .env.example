# Variables optionnelles pour docker-compose (surcharge de la base PostgreSQL).
# Copiez ce fichier en .env pour personnaliser. Sans .env, les valeurs par défaut
# ci-dessous s'appliquent. L'application ne requiert AUCUNE authentification.

POSTGRES_DB=olympics
POSTGRES_USER=olympics
POSTGRES_PASSWORD=olympics

# Déploiement hors Docker (profil prod) : définissez plutôt directement
# SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD.
