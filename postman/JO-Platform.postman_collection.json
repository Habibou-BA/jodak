{
  "info": {
    "name": "Plateforme JO",
    "description": "Collection de tests de l'API REST de la plateforme JO. Organisée par domaine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Disciplines",
      "item": [
        {
          "name": "Créer une discipline",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disciplines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disciplines"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Athlétisme\"\n}"
            },
            "description": "Crée une discipline. Réponses : 201 (créée), 400 (invalide), 409 (nom déjà utilisé)."
          }
        },
        {
          "name": "Lister les disciplines (paginé)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disciplines?page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disciplines"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name,asc" }
              ]
            }
          }
        },
        {
          "name": "Consulter une discipline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disciplines/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disciplines", "1"]
            },
            "description": "Réponses : 200 (trouvée), 404 (introuvable)."
          }
        },
        {
          "name": "Modifier une discipline",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disciplines/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disciplines", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Natation\"\n}"
            },
            "description": "Réponses : 200 (modifiée), 400 (invalide), 404 (introuvable), 409 (conflit)."
          }
        },
        {
          "name": "Supprimer une discipline",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disciplines/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disciplines", "1"]
            },
            "description": "Réponses : 204 (supprimée), 404 (introuvable), 409 (référencée)."
          }
        },
        {
          "name": "Athlètes d'une discipline (paginé)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disciplines/1/athletes?page=0&size=20&sort=lastName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disciplines", "1", "athletes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "lastName,asc" }
              ]
            },
            "description": "Réponses : 200, 404 (discipline introuvable)."
          }
        }
      ]
    },
