                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/admin/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "login"
                  ]
                },
                "description": "Authentifie un administrateur et renvoie un couple de jetons JWT. Le script de test stocke `accessToken` dans la variable `token` (réutilisée par toutes les requêtes protégées). Réponses : 200, 401 (identifiants invalides), 423 (compte verrouillé après 5 échecs).",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Connexion réussie (200)\", () => pm.response.to.have.status(200));",
                      "const j = pm.response.json();",
                      "if (j.accessToken) pm.collectionVariables.set(\"token\", j.accessToken);",
                      "if (j.refreshToken) pm.collectionVariables.set(\"refreshToken\", j.refreshToken);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Rafraîchir le jeton",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/admin/auth/refresh",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "refresh"
                  ]
                },
                "description": "Échange un refresh token valide contre un nouveau couple de jetons (rotation). Réponses : 200, 401 (jeton invalide/expiré/révoqué).",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Connexion réussie (200)\", () => pm.response.to.have.status(200));",
                      "const j = pm.response.json();",
                      "if (j.accessToken) pm.collectionVariables.set(\"token\", j.accessToken);",
                      "if (j.refreshToken) pm.collectionVariables.set(\"refreshToken\", j.refreshToken);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Déconnexion (révoquer le refresh)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/admin/auth/logout",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "logout"
                  ]
                },
                "description": "Révoque le refresh token courant. Réponses : 204.",
                "auth": {
                  "type": "noauth"
                }
              }
            }
          ]
